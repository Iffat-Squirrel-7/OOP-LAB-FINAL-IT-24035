
class Employee {
    void calculateSalary() {
        System.out.println("Calculating general employee salary...");
    }
}


class FullTimeEmployee extends Employee {
    private double monthlySalary = 50000.00;

    @Override
    void calculateSalary() {
        System.out.println("Full-Time Employee Salary: $" + monthlySalary);
    }
}


class PartTimeEmployee extends Employee {
    private int hoursWorked = 20;
    private double hourlyRate = 25.0;

    @Override
    void calculateSalary() {
        double totalSalary = hoursWorked * hourlyRate;
        System.out.println("Part-Time Employee Salary: $" + totalSalary);
    }
}


public class Main {
    public static void main(String[] args) {
        
        Employee emp;

        emp = new FullTimeEmployee();
        emp.calculateSalary(); 

        emp = new PartTimeEmployee();
        emp.calculateSalary();
    }
}
